{
  "openapi": "3.1.0",
  "info": {
    "title": "VerveCode Model Playground",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/metadata": {
      "get": {
        "summary": "Metadata",
        "operationId": "metadata_api_v1_metadata_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Metadata"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/recommendations": {
      "post": {
        "summary": "Recommend",
        "operationId": "recommend_api_v1_recommendations_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecommendationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecommendationResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "504": {
            "description": "Gateway Timeout",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Article": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "decision_label": {
            "type": "string",
            "title": "Decision Label"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "url",
          "summary",
          "category",
          "decision_label"
        ],
        "title": "Article"
      },
      "Catalog": {
        "properties": {
          "source": {
            "type": "string",
            "title": "Source"
          },
          "fetched_at": {
            "type": "string",
            "title": "Fetched At"
          },
          "articles": {
            "items": {
              "$ref": "#/components/schemas/Article"
            },
            "type": "array",
            "title": "Articles"
          }
        },
        "type": "object",
        "required": [
          "source",
          "fetched_at",
          "articles"
        ],
        "title": "Catalog"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "Metadata": {
        "properties": {
          "catalog": {
            "$ref": "#/components/schemas/Catalog"
          },
          "providers": {
            "items": {
              "$ref": "#/components/schemas/ProviderInfo"
            },
            "type": "array",
            "title": "Providers"
          }
        },
        "type": "object",
        "required": [
          "catalog",
          "providers"
        ],
        "title": "Metadata"
      },
      "OptionResult": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "probability": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Probability"
          },
          "is_none": {
            "type": "boolean",
            "title": "Is None"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "url",
          "summary",
          "category",
          "probability",
          "is_none"
        ],
        "title": "OptionResult"
      },
      "ProviderInfo": {
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "laya",
              "jev"
            ],
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "available": {
            "type": "boolean",
            "title": "Available"
          },
          "loaded": {
            "type": "boolean",
            "title": "Loaded"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "device": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Device"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "model",
          "available",
          "loaded"
        ],
        "title": "ProviderInfo"
      },
      "RecommendationRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Question"
          },
          "provider": {
            "type": "string",
            "enum": [
              "laya",
              "jev"
            ],
            "title": "Provider",
            "default": "laya"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question"
        ],
        "title": "RecommendationRequest"
      },
      "RecommendationResponse": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "question": {
            "type": "string",
            "title": "Question"
          },
          "provider": {
            "type": "string",
            "enum": [
              "laya",
              "jev"
            ],
            "title": "Provider"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "model_revision": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Revision"
          },
          "device": {
            "type": "string",
            "title": "Device"
          },
          "recommended_id": {
            "type": "string",
            "title": "Recommended Id"
          },
          "options": {
            "items": {
              "$ref": "#/components/schemas/OptionResult"
            },
            "type": "array",
            "title": "Options"
          },
          "timing": {
            "$ref": "#/components/schemas/Timing"
          },
          "input_tokens": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Input Tokens"
          },
          "catalog_version": {
            "type": "string",
            "title": "Catalog Version"
          },
          "prompt_version": {
            "type": "string",
            "title": "Prompt Version"
          },
          "probability_kind": {
            "type": "string",
            "const": "categorical_choice",
            "title": "Probability Kind",
            "default": "categorical_choice"
          }
        },
        "type": "object",
        "required": [
          "request_id",
          "question",
          "provider",
          "model",
          "model_revision",
          "device",
          "recommended_id",
          "options",
          "timing",
          "input_tokens",
          "catalog_version",
          "prompt_version"
        ],
        "title": "RecommendationResponse"
      },
      "Timing": {
        "properties": {
          "model_load_ms": {
            "type": "number",
            "title": "Model Load Ms"
          },
          "inference_ms": {
            "type": "number",
            "title": "Inference Ms"
          },
          "server_total_ms": {
            "type": "number",
            "title": "Server Total Ms"
          }
        },
        "type": "object",
        "required": [
          "model_load_ms",
          "inference_ms",
          "server_total_ms"
        ],
        "title": "Timing"
      }
    }
  }
}
